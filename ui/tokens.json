{
  "$comment": [
    "The single source of truth for every colour, size and radius.",
    "generate_tokens.py turns this into CSS custom properties, a",
    "TypeScript module and a C++ header; nothing else declares these",
    "numbers.",
    "",
    "The C++ header exists for one failure: the toolbar's height is set",
    "both by the markup that fills it and by the view that sizes it, and",
    "when the two disagree the bottom row is clipped."
  ],
  "color": {
    "background": "#0A0A0C",
    "surface": "#232326",
    "surface-raised": "#333337",
    "field": "#121118",
    "border": "#2C2C2E",
    "border-strong": "#454546",
    "text": "#F2F0F6",
    "text-dim": "#A6A5AA",
    "ring": "#C084FC",
    "accent-solid": "#A855F7",
    "on-accent-solid": "#0A0A0C",
    "danger": "#f0997b",
    "danger-bg": "#4a1b0c",
    "danger-border": "#712b13",
    "warning": "#fac775",
    "warning-bg": "#412402"
  },
  "space": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 24,
    "xxxl": 32,
    "huge": 48
  },
  "radius": {
    "$comment": [
      "13px, not 12 -- what the buttons and pills use."
    ],
    "md": 13,
    "panel": 24,
    "popup": 12,
    "square": 6,
    "pill": 999,
    "tooltip": 8,
    "menu": 10,
    "menu-item": 6,
    "notice-icon": 10,
    "detail": 8,
    "panel-inner": 14,
    "swatch": 8,
    "code": 4
  },
  "font": {
    "$comment": [
      "Instrument Sans for the interface, Outfit for display text, JetBrains",
      "Mono where alignment matters. Shipped as files, not fetched."
    ],
    "size-xs": 12,
    "size-sm": 13,
    "size-md": 14,
    "size-lg": 15,
    "weight-normal": 400,
    "weight-bold": 700,
    "size-hero": 22,
    "size-modal-title": 18,
    "size-xl": 18,
    "size-display": 22,
    "size-title": 16
  },
  "layout": {
    "$comment": [
      "Logical pixels; the C++ side converts once, at the boundary.",
      "window-width and window-height are the size a new window opens at."
    ],
    "tab-height": 32,
    "tab-min-width": 64,
    "tab-max-width": 300,
    "tab-favicon": 16,
    "new-tab-button": 34,
    "nav-button": 32,
    "address-bar-height": 35,
    "address-form-max-width": 1080,
    "toolbar-row-height": 43,
    "drag-region-width": 28,
    "window-button-width": 46,
    "window-button-height": 30,
    "chrome-padding": 8,
    "chrome-padding-bottom": 4,
    "chrome-gap": 4,
    "dock-slot": 68,
    "hero-gap": 72,
    "hero-padding-top": 96,
    "clock-size": 96,
    "search-max-width": 640,
    "search-bar-height": 68,
    "search-bar-size": 18,
    "dock-tile": 56,
    "dock-min-height": 80,
    "dock-row-min-height": 56,
    "modal-width": 360,
    "modal-input-height": 40,
    "modal-button-height": 36,
    "search-height": 68,
    "search-font": 18,
    "context-menu-min-width": 140,
    "notice-padding": 20,
    "notice-icon": 36,
    "settings-max-width": 620,
    "settings-padding-top": 56,
    "toggle-width": 42,
    "toggle-height": 24,
    "toggle-knob": 18,
    "toggle-travel": 18,
