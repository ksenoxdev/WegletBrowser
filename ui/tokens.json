    "hover-tau": 55,
    "enter": 260,
    "fast": 150,
    "ripple": 500,
    "tab-spin": 700,
    "modal": 180,
    "search-focus": 220,
    "neon-lap": 1100,
    "neon-drift": 5000,
    "neon-fade": 250,
    "neon-sweep": 1100,
    "dock-tip": 150,
    "switcher": 320,
    "preset": 100
