# weglet/BUILD.gn
#
# Everything Weglet adds to Chromium lives under this directory. Nothing
# outside it is modified, so `git status` in the Chromium tree stays
# clean and rebasing onto a new Chromium release is a fetch, not a merge.

import("//build/config/ui.gni")
import("//testing/test.gni")
import("//tools/grit/repack.gni")

executable("weglet") {
  sources = [ "app/weglet_main.cc" ]

  deps = [
    ":weglet_lib",
    "//base",
    "//build/win:default_exe_manifest",
    "//content/public/app",
  ]

  # No console window on a GUI build; the log file is the log.
  if (is_win) {
    configs -= [ "//build/config/win:console" ]
    configs += [ "//build/config/win:windowed" ]
    deps += [
      # content::InitializeSandboxInfo lives here, not in
      # //content/public/app. Without it the renderer would start
      # unsandboxed -- and in fact the link just fails.
      "//content:sandbox_helper_win",
      "//sandbox/win:sandbox",
    ]
  }

  data_deps = [
    ":weglet_pak",

    # Not a build input -- it produces nothing the binary uses. It is here
    # so the comparison actually runs: a resource pack Chromium started
    # expecting is otherwise found by a CHECK at startup.
    ":check_pak",

    # Says which Chromium tree this is. A warning by default -- see
    # check_chromium_version.py.
    ":check_chromium_version",

    # Neither produces anything the binary uses; both are here so they
    # actually run.
    ":check_generators",
    ":check_ui",
  ]
}

source_set("weglet_lib") {
  sources = [
    "app/weglet_main_delegate.cc",
    "app/weglet_main_delegate.h",
    "browser/weglet_browser_context.cc",
    "browser/weglet_browser_context.h",
    "browser/weglet_bridge.cc",
    "browser/weglet_bridge.h",
    "browser/weglet_browser_main_parts.cc",
    "browser/weglet_browser_main_parts.h",
    "browser/weglet_content_browser_client.cc",
    "browser/weglet_content_browser_client.h",
    "browser/weglet_message_handler.cc",
    "browser/weglet_message_handler.h",
    "browser/weglet_navigation_throttle.cc",
    "browser/weglet_navigation_throttle.h",
    "browser/weglet_security_guard.cc",
    "browser/weglet_security_guard.h",
    "browser/weglet_state_service.cc",
    "browser/weglet_state_service.h",
    "browser/weglet_tab_observer.cc",
    "browser/weglet_tab_observer.h",
    "browser/weglet_web_ui_controller_factory.cc",
    "browser/weglet_web_ui_controller_factory.h",
    "browser/weglet_web_ui_data_source.cc",
    "browser/weglet_web_ui_data_source.h",
    "browser/weglet_window.cc",
    "browser/weglet_window.h",
    "common/weglet_content_client.cc",
    "common/weglet_content_client.h",
    "common/weglet_host.h",
    "renderer/weglet_content_renderer_client.cc",
    "renderer/weglet_content_renderer_client.h",
  ]

  deps = [
    # The interface: design tokens, TypeScript, and the pages embedded in the
    # binary -- see ui/BUILD.gn.
    "ui",

    # The browser's own logic: tabs, history, omnibox, profile, security.
    # Built by cargo, linked here -- see rust/BUILD.gn.
    "rust:weglet_ffi",
    "//base",
    "//components/embedder_support:user_agent",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/renderer",
    "//net",
    "//ui/base",
    "//ui/display",
    "//url",
  ]

  # Chromium on desktop draws through Aura, so a WebContents cannot be
  # parented to a bare HWND -- it needs a views::Widget to live in. This
  # is the same route content_shell takes on desktop.
  if (use_aura) {
    deps += [
      "//ui/aura",
      "//ui/views",
      "//ui/views/controls/webview",
      "//ui/wm",
      "//ui/wm/public",
    ]
  }
}

# Unit tests. Run with: ninja -C out/Default weglet_unittests &&
# out/Default/weglet_unittests
#
# The generated contract is checked from the side that consumes it --
# generators_test.py checks that the generator writes the right text; this
# checks that the text means the right thing once compiled.
test("weglet_unittests") {
  sources = [ "browser/weglet_contract_unittest.cc" ]

  deps = [
    "ui",
    "//base",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
}

# The generators are the mechanism that keeps four languages saying the
# same thing, and they had no tests at all -- their only self-check was a
# duplicate-name test. A mistake in contract.json or tokens.json does not
# fail in those scripts; it produces generated C++ that fails to compile
# with an error pointing at a file nobody wrote.
action("check_generators") {
  script = "ui/generators_test.py"
  inputs = [
    "ui/contract.json",
    "ui/generate_contract.py",
    "ui/generate_tokens.py",
    "ui/tokens.json",
  ]
  outputs = [ "$target_gen_dir/generators_test.stamp" ]
  args = [
    "--stamp",
    rebase_path("$target_gen_dir/generators_test.stamp", root_build_dir),
  ]
}

# protocol.ts validates every push before a page acts on it, and that is
# the code deciding whether a malformed message is a dropped update or an
# exception halfway through rendering the tab strip. Run under the same
# vendored node build_ui.py compiles with -- no npm, no node_modules.
action("check_ui") {
  script = "ui/run_ui_tests.py"
  # Coarse on purpose, the same way ui/BUILD.gn's build_ui action is: a
  # depfile listing every .ts would be a second copy of the source list to
  # keep in step. Editing a page re-runs these; that is cheap.
  inputs = [
    "build_support.py",
    "ui/contract.json",
    "ui/generate_contract.py",
    "ui/generate_tokens.py",
    "ui/test/protocol_test.ts",
    "ui/tokens.json",
  ]
  outputs = [ "$target_gen_dir/ui_test.stamp" ]
  args = [
    "--chromium-root",
    rebase_path("//", root_build_dir),
    "--stamp",
    rebase_path("$target_gen_dir/ui_test.stamp", root_build_dir),
  ]
}

# Which Chromium revision weglet/CHROMIUM_VERSION says this is meant to be.
action("check_chromium_version") {
  script = "check_chromium_version.py"
  inputs = [
    "CHROMIUM_VERSION",
    "//chrome/VERSION",
  ]
  outputs = [ "$target_gen_dir/chromium_version_check.stamp" ]
  args = [
    "--expected",
    rebase_path("CHROMIUM_VERSION", root_build_dir),
    "--actual",
    rebase_path("//chrome/VERSION", root_build_dir),
    "--stamp",
    rebase_path("$target_gen_dir/chromium_version_check.stamp", root_build_dir),
  ]
}

# Keeps weglet_pak's hand-written list honest against the one it was
# trimmed from. See check_pak.py -- the differences are deliberate and
# declared there, so a new one is a build failure with a name in it.
action("check_pak") {
  script = "check_pak.py"
  inputs = [
    "BUILD.gn",
    "pak_exclusions.txt",
    "//content/shell/BUILD.gn",
  ]
  outputs = [ "$target_gen_dir/pak_check.stamp" ]
  args = [
    "--weglet-build",
    rebase_path("BUILD.gn", root_build_dir),
    "--shell-build",
    rebase_path("//content/shell/BUILD.gn", root_build_dir),
    "--exclusions",
    rebase_path("pak_exclusions.txt", root_build_dir),
    "--stamp",
    rebase_path("$target_gen_dir/pak_check.stamp", root_build_dir),
  ]
}

# Without a resource pack, startup trips on the first string or image
# the content layer asks ResourceBundle for.
#
# Taken from content/shell's own "pak" target and trimmed: the shell's
# own resources, its web-ui test resources and the ukm debug page are
# not ours. Whenever Chromium is updated, diff this against
# content/shell/BUILD.gn - a resource added there is usually one the
# content layer now expects everyone to have.
repack("weglet_pak") {
  sources = [
    "$root_gen_dir/base/tracing/protos/tracing_proto_resources.pak",
    "$root_gen_dir/content/browser/resources/media/media_internals_resources.pak",
    "$root_gen_dir/content/browser/webrtc/resources/webrtc_internals_resources.pak",
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/histograms_resources.pak",
    "$root_gen_dir/content/process_resources.pak",
    "$root_gen_dir/content/quota_internals_resources.pak",
    "$root_gen_dir/content/service_worker_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_generated_strings.pak",
    "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_lottie_resources.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
    "$root_gen_dir/ui/webui/resources/webui_resources.pak",
  ]

  deps = [
    "//base/tracing/protos:chrome_track_event_resources",
    "//content:content_resources",
    "//content/browser/resources",
    "//content/browser/resources/media:resources",
    "//content/browser/webrtc/resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:devtools_inspector_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//third_party/blink/public/strings:permission_element_generated_strings",
    "//third_party/blink/public/strings:permission_element_strings",
    "//ui/resources",
    "//ui/strings",
    "//ui/webui/resources",
  ]

  if (!is_android && !is_ios) {
    deps += [ "//content/browser/tracing:resources" ]
    sources += [
      "$root_gen_dir/content/browser/tracing/tracing_resources.pak",
      "$root_gen_dir/content/traces_internals_resources.pak",
    ]
  }

  # The window is a views::Widget on every desktop platform -- see the
  # use_aura block in weglet_lib above -- and views has resources of its
  # own. content/shell guards the same two lines with
  # shell_use_toolkit_views; the condition here is use_aura because that
  # is what decides whether Weglet links views at all.
  #
  # Without this the first image views asks ResourceBundle for is not
  # there, which is the failure this whole target exists to prevent.
  if (use_aura) {
    deps += [ "//ui/views/resources" ]
    sources +=
        [ "$root_gen_dir/ui/views/resources/views_resources_100_percent.pak" ]
  }

  output = "$root_out_dir/weglet.pak"
}
